VITE_APP_NAME=BELOV
VITE_APP_ENV=local

# Local backend API. Production should point to your deployed FastAPI base /api.
VITE_API_URL=http://127.0.0.1:8000/api

# Local auth token storage key. Change per environment/brand if needed.
VITE_AUTH_TOKEN_KEY=belov_access_token

# Local frontend server reference. Vite still uses CLI flags for host/port.
VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=5174

# Production examples:
# VITE_APP_ENV=production
# VITE_API_URL=https://api.belov.com/api
# VITE_AUTH_TOKEN_KEY=belov_access_token_prod
