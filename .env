VITE_APP_NAME=BELOV
VITE_APP_ENV=local

# Use Vite proxy in dev (see vite.config.js). For a physical device build, set your LAN IP:
# VITE_API_URL=http://192.168.x.x:8001/api
VITE_API_URL=/api

VITE_AUTH_TOKEN_KEY=belov_access_token
VITE_VENDOR_PORTAL_URL=http://localhost:5175

VITE_FRONTEND_HOST=127.0.0.1
VITE_FRONTEND_PORT=5174

# Production examples:
# VITE_APP_ENV=production
# VITE_API_URL=https://api.belov.com/api
# VITE_AUTH_TOKEN_KEY=belov_access_token_prod
